{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ExifBee",
  "version": "0.1.0",
  "identifier": "app.exifbee",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "ExifBee", "width": 1280, "height": 800, "minWidth": 480, "minHeight": 320 }
    ]
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
