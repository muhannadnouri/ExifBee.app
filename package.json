{
  "name": "exifbee",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "24.21.0",
    "npm": "11.19.0"
  },
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build --no-bundle",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "test:integration": "cargo test --manifest-path src-tauri/Cargo.toml --test \"*\"",
    "test:e2e:renderer": "playwright test --project=behavior",
    "test:e2e:renderer:docker": "${DOCKER:-docker} run --rm --ipc=host --user \"$(id -u):$(id -g)\" -e HOME=/tmp -v \"$PWD\":/work -w /work mcr.microsoft.com/playwright:v1.64.1-noble@sha256:47b510dd9230bf0b9bfc9b20102241e577ea7a99334ab4c3ca19f19770e9b8ea npx playwright test",
    "test:traceability": "node scripts/check-spec-traceability.mjs && vitest run scripts",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "lint": "eslint . && cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "typecheck": "tsc --noEmit && cargo check --manifest-path src-tauri/Cargo.toml --all-targets",
    "format": "prettier --write . && cargo fmt --manifest-path src-tauri/Cargo.toml",
    "format:check": "prettier --check . && cargo fmt --manifest-path src-tauri/Cargo.toml --check",
    "tauri": "tauri",
    "coverage": "vitest run --coverage.enabled --coverage.reporter=lcov --coverage.reporter=text-summary --coverage.reportsDirectory=coverage/js && cargo llvm-cov --manifest-path src-tauri/Cargo.toml --lcov --output-path coverage/rust.lcov",
    "audit:deps": "npm audit --audit-level=high && cargo audit --file src-tauri/Cargo.lock"
  },
  "dependencies": {
    "@tauri-apps/api": "2.12.4",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@tauri-apps/cli": "2.12.4",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
